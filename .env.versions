# =============================================================================
# edge-model-runtime — pinned image versions
# =============================================================================
# Hard rule: pinned semver tags only. NEVER `latest` or `main` here.
# To bump: edit, then `bash scripts/09-update-images.sh`.
# =============================================================================

# Ollama inference server
# https://hub.docker.com/r/ollama/ollama/tags
OLLAMA_IMAGE=ollama/ollama:0.23.2

# Open WebUI
# https://github.com/open-webui/open-webui/releases
OPEN_WEBUI_IMAGE=ghcr.io/open-webui/open-webui:v0.9.2

# LiteLLM proxy (opt-in via `--profile cloud`)
# Bridges Claude / OpenAI / Gemini into one OpenAI-compatible endpoint.
# Note: LiteLLM publishes versioned stable tags as `main-v<X.Y.Z>-stable`
# (the `main-` prefix is their release convention — these are immutable
# pinned tags, NOT a moving `:main` tag). Bump when you want a newer one.
# https://github.com/BerriAI/litellm/pkgs/container/litellm
LITELLM_IMAGE=ghcr.io/berriai/litellm:main-v1.65.0-stable

# vLLM (opt-in via `--profile vllm`)
# https://github.com/vllm-project/vllm/releases
VLLM_IMAGE=vllm/vllm-openai:v0.20.1

# NVIDIA PyTorch (opt-in via `--profile training`)
# https://docs.nvidia.com/deeplearning/frameworks/pytorch-release-notes/
TRAINING_IMAGE=nvcr.io/nvidia/pytorch:26.04-py3

# Small CUDA base used only for the GPU smoke test in 00-install.sh
CUDA_TEST_IMAGE=nvidia/cuda:12.6.3-base-ubuntu22.04

# OpenHands agentic web IDE (opt-in via `--profile coding-web`)
# https://github.com/All-Hands-AI/OpenHands/releases
# `:1.7` is the upstream stable major.minor tag (their release convention),
# NOT a moving alias — bump deliberately.
OPENHANDS_IMAGE=docker.openhands.dev/openhands/openhands:1.7
# Sandbox/runtime image — pulled by OpenHands per session via Docker socket.
# Tag format: `<major>.<minor>.<patch>-python`.
OPENHANDS_AGENT_IMAGE_TAG=1.19.1-python
