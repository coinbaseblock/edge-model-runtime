{
  "": "https://opencode.ai/config.json",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "localmodel26b:latest":  { "name": "LocalModel 26B (gemma4 family, vision)" },
        "localmodel26b-32k:latest": { "name": "LocalModel 26B 32k ctx (recommended)" },
        "qwen3-coder:30b":       { "name": "Qwen3-Coder 30B" },
        "qwen3-coder-32k:latest": { "name": "Qwen3-Coder 30B 32k ctx (recommended)" },
        "gemma4:26b":            { "name": "Gemma4 26B (vision)" },
        "gemma4-32k:latest":     { "name": "Gemma4 26B 32k ctx" },
        "qwen2.5vl:7b":          { "name": "Qwen2.5-VL 7B (vision)" },
        "qwen2.5vl-32k:latest":  { "name": "Qwen2.5-VL 7B 32k ctx" }
      }
    },
    "litellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LiteLLM (cloud + local via proxy)",
      "options": {
        "baseURL": "http://localhost:4000/v1",
        "apiKey": "{env:LITELLM_MASTER_KEY}"
      },
      "models": {
        "claude-opus-4-7":       { "name": "Claude Opus 4.7 (cloud)" },
        "claude-sonnet-4-6":     { "name": "Claude Sonnet 4.6 (cloud)" },
        "claude-haiku-4-5":      { "name": "Claude Haiku 4.5 (cloud)" },
        "localmodel26b-32k":     { "name": "LocalModel 26B 32k (via proxy)" },
        "qwen3-coder-32k":       { "name": "Qwen3-Coder 30B 32k (via proxy)" },
        "lmstudio":              { "name": "LM Studio (host, via LiteLLM)" }
      }
    }
  },
  "model": "ollama/localmodel26b-32k:latest",
  "mcp": {
    "ollama-tools": {
      "type": "local",
      "command": ["python3", "scripts/lib/ollama-mcp-server.py"],
      "environment": {
        "OLLAMA_URL": "http://localhost:11434",
        "OLLAMA_DEFAULT_MODEL": "localmodel26b-32k:latest",
        "OLLAMA_EMBED_MODEL": "nomic-embed-text"
      }
    }
  }
}
