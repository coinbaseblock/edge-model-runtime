# =============================================================================
# edge-model-runtime — runtime configuration
# =============================================================================
# Copy to .env and edit. .env is gitignored.
# Image tags live in .env.versions, NOT here.
# =============================================================================

# --- Host data root ----------------------------------------------------------
# All persistent state (models, WebUI db, HF cache, training output) lives here.
# Must be on a disk with plenty of free space. Bind-mounted into containers.
AI_DATA_ROOT=/mnt/edge-backup/ai-data

# --- Ports -------------------------------------------------------------------
OLLAMA_PORT=11434
WEBUI_PORT=3000
LITELLM_PORT=4000
VLLM_PORT=8000
TENSORBOARD_PORT=6006
JUPYTER_PORT=8888

# --- Open WebUI --------------------------------------------------------------
# REQUIRED. Generated automatically by scripts/00-install.sh on first run.
# Rotating this logs out all WebUI users.
WEBUI_SECRET_KEY=
WEBUI_ENABLE_SIGNUP=true
WEBUI_DEFAULT_USER_ROLE=pending

# --- Ollama tunables ---------------------------------------------------------
OLLAMA_KEEP_ALIVE=30m
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_FLASH_ATTENTION=1

# --- NVIDIA ------------------------------------------------------------------
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,utility

# --- vLLM (optional, --profile vllm) -----------------------------------------
VLLM_MODEL=Qwen/Qwen2.5-Coder-7B-Instruct
VLLM_MAX_MODEL_LEN=4096
VLLM_GPU_MEM_UTIL=0.90

# --- LiteLLM cloud proxy (optional, --profile cloud) -------------------------
# Run `bash scripts/32-setup-cloud-models.sh` for a guided setup; it fills these
# in for you. Once running, cloud models appear in Open WebUI's model dropdown
# alongside local Ollama models.
#
# Master key the proxy requires from clients (Open WebUI, opencode, curl, …).
# Generated automatically by 32-setup-cloud-models.sh. Treat like a password.
LITELLM_MASTER_KEY=
# Provider keys. Leave any unused one empty — the proxy disables that provider.
ANTHROPIC_API_KEY=
OPENAI_PROVIDER_API_KEY=
GEMINI_API_KEY=
# LiteLLM log verbosity: DEBUG | INFO | WARNING | ERROR
LITELLM_LOG=INFO

# --- Secrets (optional) ------------------------------------------------------
HF_TOKEN=
WANDB_API_KEY=
