# =============================================================================
# edge-model-runtime — runtime configuration
# =============================================================================
# Copy to .env and edit. .env is gitignored.
# Image tags live in .env.versions, NOT here.
# =============================================================================

# --- Host data root ----------------------------------------------------------
# All persistent state (models, WebUI db, HF cache, training output) lives here.
# Must be on a disk with plenty of free space. Bind-mounted into containers.
AI_DATA_ROOT=/mnt/edge-backup/ai-data

# --- Ports -------------------------------------------------------------------
OLLAMA_PORT=11434
WEBUI_PORT=3000
VLLM_PORT=8000
TENSORBOARD_PORT=6006
JUPYTER_PORT=8888

# --- Open WebUI --------------------------------------------------------------
# REQUIRED. Generated automatically by scripts/00-install.sh on first run.
# Rotating this logs out all WebUI users.
WEBUI_SECRET_KEY=
WEBUI_ENABLE_SIGNUP=true
WEBUI_DEFAULT_USER_ROLE=pending

# --- Ollama tunables ---------------------------------------------------------
OLLAMA_KEEP_ALIVE=30m
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_FLASH_ATTENTION=1

# --- NVIDIA ------------------------------------------------------------------
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,utility

# --- vLLM (optional, --profile vllm) -----------------------------------------
VLLM_MODEL=Qwen/Qwen2.5-Coder-7B-Instruct
VLLM_MAX_MODEL_LEN=4096
VLLM_GPU_MEM_UTIL=0.90

# --- Secrets (optional) ------------------------------------------------------
HF_TOKEN=
WANDB_API_KEY=
