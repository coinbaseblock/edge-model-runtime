# =============================================================================
# edge-model-runtime — runtime configuration
# =============================================================================
# Copy to .env and edit. .env is gitignored.
# Image tags live in .env.versions, NOT here.
# =============================================================================

# --- Host data root ----------------------------------------------------------
# All persistent state (models, WebUI db, HF cache, training output) lives here.
# Must be on a disk with plenty of free space. Bind-mounted into containers.
AI_DATA_ROOT=/mnt/edge-backup/ai-data

# --- Ports -------------------------------------------------------------------
OLLAMA_PORT=11434
WEBUI_PORT=3000
LITELLM_PORT=4000
VLLM_PORT=8000
TENSORBOARD_PORT=6006
JUPYTER_PORT=8888

# --- Open WebUI --------------------------------------------------------------
# REQUIRED. Generated automatically by scripts/00-install.sh on first run.
# Rotating this logs out all WebUI users.
WEBUI_SECRET_KEY=
WEBUI_ENABLE_SIGNUP=true
WEBUI_DEFAULT_USER_ROLE=pending

# --- Ollama tunables ---------------------------------------------------------
OLLAMA_KEEP_ALIVE=30m
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_FLASH_ATTENTION=1

# --- NVIDIA ------------------------------------------------------------------
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,utility

# --- vLLM (optional, --profile vllm) -----------------------------------------
VLLM_MODEL=Qwen/Qwen2.5-Coder-7B-Instruct
VLLM_MAX_MODEL_LEN=4096
VLLM_GPU_MEM_UTIL=0.90

# --- LiteLLM cloud proxy (optional, --profile cloud) -------------------------
# Run `bash scripts/32-setup-cloud-models.sh` for a guided setup; it fills these
# in for you. Once running, cloud models appear in Open WebUI's model dropdown
# alongside local Ollama models.
#
# Master key the proxy requires from clients (Open WebUI, opencode, curl, …).
# Generated automatically by 32-setup-cloud-models.sh. Treat like a password.
LITELLM_MASTER_KEY=
# Provider keys. Leave any unused one empty — the proxy disables that provider.
ANTHROPIC_API_KEY=
OPENAI_PROVIDER_API_KEY=
GEMINI_API_KEY=
# LiteLLM log verbosity: DEBUG | INFO | WARNING | ERROR
LITELLM_LOG=INFO

# --- LM Studio bridge (optional, host-side desktop app) ----------------------
# LM Studio (https://lmstudio.ai) is a desktop app, not a container. Install it
# on the host, load a model, and turn on "Local Server" (default :1234). It
# exposes BOTH an OpenAI-compatible API at /v1/* AND an Anthropic-compatible
# API at /v1/messages — Claude Code can talk to it directly via
# ANTHROPIC_BASE_URL, no proxy required.
#
# Run `bash scripts/37-setup-lmstudio.sh` to also wire it through LiteLLM so
# the same model shows up in Open WebUI / OpenCode / OpenHands.
#
# LMSTUDIO_HOST is what *containers* use to reach the host. `host.docker.internal`
# resolves to the host gateway (extra_hosts is set in docker-compose.yml).
# Tools running on the host itself (Claude Code, OpenCode CLI) ignore this and
# use `localhost` directly.
LMSTUDIO_HOST=host.docker.internal
LMSTUDIO_PORT=1234
# Model id LM Studio reports for its currently-loaded model. Get the exact
# string from LM Studio → Developer → "API Model Identifier" (e.g. shown in
# the right-hand panel). Wrong id = 404 from LM Studio at call time.
LMSTUDIO_MODEL=openai/gpt-oss-20b
# LM Studio does not require auth by default; LiteLLM still wants a non-empty
# value to forward, so we send a placeholder. Override only if you enabled
# auth in LM Studio's server settings.
LMSTUDIO_API_KEY=lm-studio

# --- OpenHands web agentic IDE (optional, --profile coding-web) --------------
# Run `bash scripts/36-setup-coding-web.sh` for a guided setup. Browser UI at
# http://<host>:${OPENHANDS_PORT}. Uses the LiteLLM proxy (above) for model
# inference, so all the cloud + local models you've registered are available.
OPENHANDS_PORT=3030
# OpenHands → LLM endpoint. Default targets the in-network litellm service.
# Override only if running LiteLLM elsewhere (e.g. on the host directly).
OPENHANDS_LLM_BASE_URL=http://litellm:4000

# GitHub OAuth (optional — without these, paste a PAT in OpenHands Settings).
# Register an OAuth app: https://github.com/settings/developers → New OAuth App
#   Authorization callback URL:
#     http://<host>:${OPENHANDS_PORT}/api/integrations/github/callback
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=

# --- Secrets (optional) ------------------------------------------------------
HF_TOKEN=
WANDB_API_KEY=
