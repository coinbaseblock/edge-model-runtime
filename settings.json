{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(bash scripts/*.sh:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)",
      "Bash(docker compose pull:*)",
      "Bash(docker compose up *)",
      "Bash(docker compose down)",
      "Bash(docker exec edge-ollama ollama list)",
      "Bash(docker exec edge-ollama ollama show:*)",
      "Bash(docker ps:*)",
      "Bash(docker images:*)",
      "Bash(docker system df)",
      "Bash(curl -sf http://localhost:*)",
      "Bash(du -sh:*)",
      "Bash(df -h:*)",
      "Bash(nvidia-smi:*)",
      "Read(./**)",
      "Edit(scripts/**)",
      "Edit(docker-compose.yml)",
      "Edit(.env.example)",
      "Edit(.env.versions)",
      "Edit(docs/**)",
      "Edit(training/**)",
      "Edit(README.md)",
      "Edit(CLAUDE.md)"
    ],
    "deny": [
      "Bash(bash scripts/20-wipe-models.sh:*)",
      "Bash(rm -rf /mnt/edge-backup/**)",
      "Bash(sudo rm -rf:*)",
      "Bash(docker volume rm:*)",
      "Bash(docker system prune *)",
      "Edit(.env)"
    ]
  }
}
